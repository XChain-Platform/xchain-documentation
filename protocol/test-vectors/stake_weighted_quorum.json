{
  "_description": "Canonical conformance vectors for the stake-weighted quorum predicate (STAKE_WEIGHTED_QUORUM / WI-1). Each service (xchain-hub, xchain-indexer, xchain-explorer, xchain-sdk, xchain-sync) keeps a hand-maintained copy of stake_weighted_quorum.js in a different bignum dialect (bcmath / injected util / mathjs). A divergence in predicate logic forks the chain. Each repo's conformance test runs these vectors against its local copy so any behavioral drift is machine-detectable. This file is the single source of truth; do not fork it. Predicate: a source-deduped quorum holds iff 3 * sum(distinct signing-source weight) > 2 * S, where S = sum of weight over distinct sources; pubkeys are matched case-insensitively; a blank or missing source fails closed.",
  "meetsStakeThreshold": [
    {
      "name": "single source meets the threshold (3S > 2S)",
      "validators": [{ "pubkey": "K1", "source": "s1", "weight": "10" }],
      "signers": ["K1"],
      "expected": true
    },
    {
      "name": "empty signer set fails (0 > 0 is false)",
      "validators": [{ "pubkey": "K1", "source": "s1", "weight": "10" }],
      "signers": [],
      "expected": false
    },
    {
      "name": "two of three equal sources fail the strict 2/3 boundary (60 > 60 is false)",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" }
      ],
      "signers": ["K1", "K2"],
      "expected": false
    },
    {
      "name": "all three equal sources pass (90 > 60)",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" }
      ],
      "signers": ["K1", "K2", "K3"],
      "expected": true
    },
    {
      "name": "three of four equal sources pass (>2/3)",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" },
        { "pubkey": "K4", "source": "s4", "weight": "10" }
      ],
      "signers": ["K1", "K2", "K3"],
      "expected": true
    },
    {
      "name": "two of four equal sources fail",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" },
        { "pubkey": "K4", "source": "s4", "weight": "10" }
      ],
      "signers": ["K1", "K2"],
      "expected": false
    },
    {
      "name": "source dedup: two keys of one source count that source once (insufficient)",
      "validators": [
        { "pubkey": "K1a", "source": "s1", "weight": "10" },
        { "pubkey": "K1b", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" }
      ],
      "signers": ["K1a", "K1b"],
      "expected": false
    },
    {
      "name": "pubkey match is case-insensitive",
      "validators": [{ "pubkey": "ABCD", "source": "s1", "weight": "10" }],
      "signers": ["abcd"],
      "expected": true
    },
    {
      "name": "a duplicate signer pubkey is counted once",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" }
      ],
      "signers": ["K1", "K1", "K2"],
      "expected": false
    },
    {
      "name": "an unknown signer pubkey is ignored, not counted",
      "validators": [{ "pubkey": "K1", "source": "s1", "weight": "10" }],
      "signers": ["K1", "UNKNOWN"],
      "expected": true
    },
    {
      "name": "blank source fails closed even though it would otherwise pass",
      "validators": [{ "pubkey": "K1", "source": "", "weight": "10" }],
      "signers": ["K1"],
      "expected": false
    },
    {
      "name": "weighted: one heavy source alone exceeds 2/3 of total (300 > 240)",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "100" },
        { "pubkey": "K2", "source": "s2", "weight": "10" },
        { "pubkey": "K3", "source": "s3", "weight": "10" }
      ],
      "signers": ["K1"],
      "expected": true
    },
    {
      "name": "decimal weights: fractional stake math is exact (4.5 > 3.0)",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "0.5" },
        { "pubkey": "K2", "source": "s2", "weight": "0.5" },
        { "pubkey": "K3", "source": "s3", "weight": "0.5" }
      ],
      "signers": ["K1", "K2", "K3"],
      "expected": true
    }
  ],
  "totalStake": [
    {
      "name": "sums weight over distinct sources (first weight per source wins)",
      "validators": [
        { "pubkey": "K1", "source": "s1", "weight": "10" },
        { "pubkey": "K1b", "source": "s1", "weight": "10" },
        { "pubkey": "K2", "source": "s2", "weight": "5" }
      ],
      "expected": "15"
    },
    {
      "name": "a blank source throws (a collapsed bucket is meaningless)",
      "validators": [{ "pubkey": "K1", "source": "", "weight": "10" }],
      "throws": true
    }
  ]
}
